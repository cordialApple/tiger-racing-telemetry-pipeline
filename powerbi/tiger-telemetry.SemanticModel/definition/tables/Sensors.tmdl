/// Sensor master dimension : one row per distinct channel name across the season, derived from Channels.
table Sensors
	lineageTag: f0d9ba9a-5c3d-4278-8089-59ea26a9d7e0

	measure 'Sensor Count' = COUNTROWS(Sensors)
		formatString: #,0
		lineageTag: 3f8a1c2e-9b4d-4e6f-a1b2-c3d4e5f60008

	column sensor_name
		lineageTag: 6d84bcd6-97a1-4a81-a622-d498bfaa05a6
		isNameInferred
		sourceColumn: Channels[sensor_name]

	column description
		lineageTag: b298d23d-25bf-463d-8937-ff8a17a6e1e4
		isNameInferred
		sourceColumn: [description]

	column unit
		lineageTag: 075dc291-a8b2-4997-9af0-a99ea9625b35
		isNameInferred
		sourceColumn: [unit]

	column live_sessions
		lineageTag: 53013b41-d4a5-45f2-a45c-6e657a1b2d85
		isNameInferred
		sourceColumn: [live_sessions]

	column is_live
		lineageTag: 241473ec-5fb3-4a67-948b-e11edb823c76
		isNameInferred
		sourceColumn: [is_live]

	partition Sensors_Partition = calculated
		mode: import
		source =
				VAR base =
				    ADDCOLUMNS(
				        VALUES(Channels[sensor_name]),
				        "description", CALCULATE(MAX(Channels[description])),
				        "unit", CALCULATE(MAX(Channels[unit])),
				        "live_sessions", CALCULATE(COUNTROWS(FILTER(Channels, Channels[has_signal] = TRUE())))
				    )
				RETURN
				    ADDCOLUMNS(base, "is_live", COALESCE([live_sessions], 0) > 0)

